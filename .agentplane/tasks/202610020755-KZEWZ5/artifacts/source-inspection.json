  "conclusions": [
    "Both validity overloads are protected",
    "Self query delegates to the parent; root/orphan false",
    "Explicit nullable child query checks retained cache,nonnull child and exact parent before sorted lookup/comparison",
    "AddChild and Invalidate use self validity at native call sites",
    "Removing a client from an invalid rule invalidates the remaining list prefix while retaining raw counters"
  ],
  "limits": [
    "No compiled native probe",
    "No native invalid-cache UB, full layout/redline/dtor/context/client/lifetime certification",
