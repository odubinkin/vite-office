  "driverSource": "#include \"../../vendor/md4c-reference/src/md4c.c\"\nstatic unsigned counts[32];static unsigned char output[8192];static unsigned used;\nstatic int block(MD_BLOCKTYPE t,void*d,void*u){(void)t;(void)d;(void)u;return 0;}\nstatic int span_start(MD_SPANTYPE t,void*d,void*u){(void)d;(void)u;counts[t]++;return 0;}\nstatic int span_end(MD_SPANTYPE t,void*d,void*u){(void)t;(void)d;(void)u;return 0;}\nstatic int text_out(MD_TEXTTYPE t,const MD_CHAR*s,MD_SIZE n,void*u){(void)t;(void)u;memcpy(output+used,s,n);used+=n;return 0;}\nint main(void){const char*inputs[]={\"[x][[missing]]\",\"[[x]][]\",\"[x][foo[bar]]\",\"[x][foo[bar]]\\n\\n[bar]: /b\",\"[[x]][ref]\",\"[![x](url)][]\",\"[*[x]*][]\",\"[x][][]\",\"[[x]][]\\n\\n[x]: /x\",\"[x][[y]]\\n\\n[y]: /y\",\"[a [b]][]\",\"[x][foo[bar]]\\n\\n[x]: /x\\n[foo[bar]]: /y\"};\nfor(unsigned k=0;k<sizeof(inputs)/sizeof(inputs[0]);k++){memset(counts,0,sizeof(counts));used=0;\n MD_PARSER p={0};p.flags=MD_FLAG_PERMISSIVEAUTOLINKS;p.enter_block=block;p.leave_block=block;p.enter_span=span_start;p.leave_span=span_end;p.text=text_out;\n int result=md_parse(inputs[k],(MD_SIZE)strlen(inputs[k]),&p,0);printf(\"[%d,[\",result);\n for(int i=0;i<32;i++)printf(\"%s%u\",i?\",\":\"\",counts[i]);printf(\"],\\\"\");\n for(unsigned i=0;i<used;i++)printf(\"%02x\",output[i]);printf(\"\\\"]\\n\");}\nreturn 0;}\n"
