    { "localPath": "apps/office/src/sw/source/core/doc/writer.ts", "rationale": "The browser document model is named for the Writer aggregate it owns; the pinned docnew.cxx counterpart owns document creation, so preserving its basename would falsely narrow the local model's responsibility." },
