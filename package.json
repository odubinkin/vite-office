{
  "name": "vite-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @vite-office/office",
    "check": "npm run verify",
    "check:dependencies": "node scripts/check-module-boundaries.mjs",
    "check:docs": "node scripts/check-jsdoc.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:source-provenance": "tsx scripts/check-source-provenance.ts",
    "check:source-tree": "node scripts/check-lo-source-tree.mjs",
    "dev": "npm run dev --workspace @vite-office/office",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:writer-resources": "tsx scripts/generate-writer-ui-resources.ts",
    "check:writer-resources": "tsx scripts/generate-writer-ui-resources.ts --check && vitest run scripts/writer-ui-resource-model.test.ts",
    "inventory:validate": "tsx scripts/libreoffice-inventory/cli.ts",
    "inventory:modules": "tsx scripts/libreoffice-inventory/modules-cli.ts",
    "inventory:parity": "tsx scripts/libreoffice-inventory/registry-cli.ts check",
    "inventory:tests": "tsx scripts/libreoffice-inventory/tests-cli.ts",
    "inventory:test-source-targets": "tsx scripts/libreoffice-inventory/test-source-target-cli.ts",
    "inventory:junit-source-targets": "tsx scripts/libreoffice-inventory/junit-source-target-cli.ts",
    "inventory:python-test-modules": "tsx scripts/libreoffice-inventory/python-test-module-cli.ts",
    "inventory:ui-test-source-targets": "tsx scripts/libreoffice-inventory/ui-test-source-cli.ts",
    "inventory:cppunit-registrations": "tsx scripts/libreoffice-inventory/cppunit-registration-cli.ts",
    "inventory:help-topics": "tsx scripts/libreoffice-inventory/help-topics-cli.ts",
    "inventory:invariants": "tsx scripts/libreoffice-inventory/registry-cli.ts check",
    "inventory:invariants:write": "tsx scripts/libreoffice-inventory/registry-cli.ts build",
    "inventory:translations": "tsx scripts/libreoffice-inventory/translations-cli.ts",
    "inventory:dictionaries": "tsx scripts/libreoffice-inventory/dictionaries-cli.ts",
    "lint": "eslint . --max-warnings 0",
    "preview": "npm run preview --workspace @vite-office/office",
    "test": "npm run test:coverage && npm run test:inventory:coverage",
    "test:inventory:coverage": "vitest run --config scripts/libreoffice-inventory/vitest.config.ts --coverage",
    "test:source-provenance": "vitest run scripts/check-source-provenance.test.ts",
    "test:coverage": "npm run test:coverage --workspace @vite-office/office --",
    "test:e2e": "npm run build && playwright test --config apps/office/playwright.config.ts",
    "test:static": "npm run build && node scripts/check-static-build.mjs",
    "typecheck": "npm run typecheck:tools && npm run typecheck --workspace @vite-office/office",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:dependencies && npm run check:writer-resources && npm run test:tooling && npm run test:coverage && npm run test:inventory:coverage && npm run test:e2e && npm run test:static && npm run check:docs && npm run check:file-size && npm run check:source-tree && npm run check:source-provenance && npm run inventory:invariants && npm run inventory:parity",
    "test:writer": "npm run test:writer --workspace @vite-office/office --",
    "test:coverage:writer": "npm run test:coverage:writer --workspace @vite-office/office --",
    "test:e2e:writer": "npm run build && playwright test --config apps/office/playwright.config.ts --project writer",
    "test:calc": "npm run test:calc --workspace @vite-office/office --",
    "test:coverage:calc": "npm run test:coverage:calc --workspace @vite-office/office --",
    "test:e2e:calc": "npm run build && playwright test --config apps/office/playwright.config.ts --project calc --pass-with-no-tests",
    "test:shared": "npm run test:shared --workspace @vite-office/office --",
    "test:coverage:shared": "npm run test:coverage:shared --workspace @vite-office/office --",
    "test:e2e:shared": "npm run build && playwright test --config apps/office/playwright.config.ts --project shared",
    "test:all": "npm test && npm run test:tooling && npm run test:e2e",
    "test:tooling": "vitest run scripts/test-projects.test.ts scripts/check-module-boundaries.test.ts",
    "inventory:id": "tsx scripts/libreoffice-inventory/registry-cli.ts id",
    "inventory:registry:check": "tsx scripts/libreoffice-inventory/registry-cli.ts check",
    "inventory:registry:build": "tsx scripts/libreoffice-inventory/registry-cli.ts build",
    "inventory:parity:writer": "tsx scripts/libreoffice-inventory/registry-cli.ts check --scope writer",
    "inventory:parity:calc": "tsx scripts/libreoffice-inventory/registry-cli.ts check --scope calc",
    "inventory:parity:shared": "tsx scripts/libreoffice-inventory/registry-cli.ts check --scope shared"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
