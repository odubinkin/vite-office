
# agentplane: ignore runtime/transient workspace artifacts
.env
.agentplane/worktrees
.agentplane/tmp
.agentplane/local-backups
.agentplane/cache
.agentplane/cache.sqlite
.agentplane/cache.sqlite-wal
.agentplane/cache.sqlite-shm
.agentplane/recipes-cache
.agentplane/generated/obsidian
.agentplane/.upgrade
.agentplane/.release
.agentplane/upgrade
.agentplane/tasks.json
.agentplane/index.md
.agentplane/tasks.md
.agentplane/by-status
.agentplane/by-tag
.agentplane/by-owner
.agentplane/tasks/*/handoff
# Exclusion guards do not permit saving upstream/native sources in Agentplane.
.agentplane/tasks/**/*.c
.agentplane/tasks/**/*.cpp
.agentplane/tasks/**/*.cxx
.agentplane/tasks/**/*.h
.agentplane/tasks/**/*.hpp
.agentplane/tasks/**/*.hxx
# Python generators, edit helpers and bytecode must not be Agentplane artifacts.
.agentplane/**/*.py
.agentplane/**/*.pyc
.agentplane/**/*.pyo
AGENTS.md.bak-*
CLAUDE.md.bak-*
.agentplane/agents/*.bak-*
.agentplane/policy/**/*.bak-*

# Browser-office dependencies, generated output, and local reference sources
node_modules/
apps/*/dist/
coverage/
playwright-report/
test-results/
output/playwright/
vendor/libreoffice-reference/
.playwright-cli

# Deterministic compatibility views; author docs/program/registry records instead
/docs/program/parity/writer-command-slice.json
/docs/program/parity/runtime-inventory.json
/docs/program/source-provenance.json
/docs/program/parity/upstream-invariants.json
