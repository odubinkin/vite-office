{
  "name": "@vite-office/office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:writer": "vitest run --config vitest.writer.config.ts",
    "test:coverage:writer": "vitest run --config vitest.writer.config.ts --coverage",
    "test:calc": "vitest run --config vitest.calc.config.ts",
    "test:coverage:calc": "vitest run --config vitest.calc.config.ts --coverage",
    "test:shared": "vitest run --config vitest.shared.config.ts",
    "test:coverage:shared": "vitest run --config vitest.shared-coverage.config.ts --coverage"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0"
  }
}
